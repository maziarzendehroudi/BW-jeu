const CACHE_NAME = 'batwatt-v0.1';
const ASSETS_TO_CACHE = [
    './',
    './index.html',
    './manifest.json',
    './icon-192.png',
    './icon-512.png',
    './icon.svg'
];

self.addEventListener('install', (event) => {
    console.log('[Service Worker] Installation et mise en cache');
    event.waitUntil(
        caches.open(CACHE_NAME).then((cache) => {
            return cache.addAll(ASSETS_TO_CACHE);
        })
    );
    self.skipWaiting();
});

self.addEventListener('activate', (event) => {
    // Nettoie les anciens caches si on change de version (ex: batwatt-v0.2)
    event.waitUntil(
        caches.keys().then((keyList) => {
            return Promise.all(keyList.map((key) => {
                if (key !== CACHE_NAME) {
                    return caches.delete(key);
                }
            }));
        }).then(() => clients.claim())
    );
});

self.addEventListener('fetch', (event) => {
    // Stratégie "Cache First" (cherche d'abord dans le cache, puis sur le réseau)
    event.respondWith(
        caches.match(event.request).then((response) => {
            return response || fetch(event.request);
        })
    );
});
